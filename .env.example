# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (PostgreSQL + authentication) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — use test keys (sk_test_…) until launch
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to true once Stripe Tax is enabled in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Café Rojo <orders@example.com>"
CONTACT_TO=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# Retell AI — "call me" voice guide on the checkout page
RETELL_API_KEY=
# The Retell phone number that places the call, in +1XXXXXXXXXX format
RETELL_FROM_NUMBER=
# Optional: agent to use for these calls. If blank, the number's default outbound agent is used.
RETELL_AGENT_ID=
